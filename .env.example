# ---- Ecobiome CMS — nusxa oling:  cp .env.example .env  ----
NODE_ENV=production
PORT=3000

# Saytning to'liq manzili (og:image uchun absolyut havola). Oxirida "/" qo'ymang.
SITE_URL=https://ecobiome.uz

# MAXFIY KALIT: kamida 32 ta tasodifiy belgi. Yaratish:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Admin sessiyasi davomiyligi (soat). Harakatsiz qolsa shu muddatdan keyin chiqarib yuboradi.
SESSION_HOURS=8

# HTTPS orqasida (nginx / hosting proxy) ishlasa 1 qiling
TRUST_PROXY=1
# Cookie faqat HTTPS orqali (production'da standart = 1). Lokal HTTP sinov uchun 0.
COOKIE_SECURE=1

# Fayl yo'llari (loyiha papkasiga nisbatan)
DB_PATH=data/ecobiome.sqlite
UPLOADS_DIR=uploads
BACKUPS_DIR=backups

# Yuklash limitlari (MB)
MAX_UPLOAD_MB=10
MAX_IMPORT_MB=500

# Login himoyasi
LOGIN_MAX_ATTEMPTS=5        # hisob bloklanishidan oldingi noto'g'ri urinishlar
LOGIN_LOCK_MINUTES=15       # blok davomiyligi
LOGIN_MAX_IP_ATTEMPTS=20    # bitta IP'dan 15 daqiqada ruxsat etilgan noto'g'ri urinishlar

# Vaqt zonasi (kunlik backup soati shu bo'yicha hisoblanadi)
TZ=Asia/Tashkent

# ---- Backup ----
# Server har kuni o'zi backup oladi (cron shart emas). O'chirish: BACKUP_AUTO=0
BACKUP_AUTO=1
BACKUP_HOUR=3               # soat nechada (0–23)
BACKUP_KEEP=14              # serverda nechta oxirgi nusxa saqlansin

# Onlayn (serverdan tashqari) nusxa — rclone orqali. Bo'sh qoldirilsa faqat serverda saqlanadi.
# Masalan Google Drive: OFFSITE_REMOTE=gdrive:ecobiome-backups   (README, 6-bo'lim)
OFFSITE_REMOTE=
OFFSITE_KEEP_DAYS=90        # onlayn xotirada necha kunlik nusxalar saqlansin
RCLONE_CONFIG=rclone.conf   # rclone sozlamalari fayli (loyiha papkasida)
