<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main">

<%- include('../partials/page-hero') %>

  <section class="section-alt">
    <div class="container">
<% if (b.people_intro.note) { %>      <p class="demo-note"><%= b.people_intro.note %></p>
<% } %>
<% groups.forEach((g, gi) => { %>
<% if (gi > 0) { %>      <hr class="divider">

<% } %>      <div class="section-head">
        <p class="eyebrow"><%= b.people_intro[g.key + '_eyebrow'] %></p>
        <h2><%= b.people_intro[g.key + '_title'] %></h2>
      </div>
      <div class="grid <%= g.key === 'pi' ? 'grid-2' : 'grid-3' %>">
<% g.people.forEach(p => { %>        <div class="person" id="person-<%= p.slug %>">
<% if (p.photo) { %>          <div class="avatar"><img src="<%= p.photo %>" alt="<%= p.photo_alt || p.name %>" style="width:100%; height:100%; object-fit:cover; border-radius:50%;" loading="lazy"></div>
<% } else { %>          <div class="avatar"><%= p.initials %></div>
<% } %>          <h3><%= p.name %></h3>
          <span class="role"><%= p.role_title %></span>
          <p><%= p.bio %></p>
<% const links = [];
   if (p.email) links.push({ href: 'mailto:' + p.email, text: p.email, ext: false, email: true });
   (p.links || []).forEach(l => { if (l.url) links.push({ href: l.url, text: l.label || l.url, ext: !/^(\/|#|mailto:|tel:)/.test(l.url) }); });
   if (links.length) { %>          <div class="person-links">
<% links.forEach(l => { %>            <a class="person-link<%= l.email ? ' is-email' : '' %>" href="<%= l.href %>"<% if (l.ext) { %> target="_blank" rel="noopener noreferrer"<% } %>><% if (l.email) { %><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><% } else { %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1"/><path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"/></svg><% } %><span><%= l.text %></span><% if (l.ext) { %><svg class="ext" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg><% } %></a>
<% }) %>          </div>
<% } if (p.tags.length) { %>          <div class="card-tags"><% p.tags.forEach(t => { %><span class="tag"><%= t %></span><% }) %></div>
<% } %>        </div>
<% }) %>      </div>
<% }) %>
    </div>
  </section>

<%- include('../partials/cta') %>
</main>

<%- include('../partials/footer') %>
