<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main">

<%- include('../partials/page-hero') %>

  <section class="section-alt">
    <div class="container">
      <div class="grid grid-3">
<% news.forEach(n => { %>
        <article class="news-card">
<% if (n.cover) { %>          <img src="<%= n.cover %>" alt="<%= n.cover_alt %>" style="width:100%; height:190px; object-fit:cover;" loading="lazy">
<% } %>          <div class="body">
            <span class="date"><%= fmtDate(n.date) %><%= n.label ? ' · ' + n.label : '' %></span>
            <h3><%= n.title %></h3>
            <p><%= n.excerpt %></p>
            <a href="/news/<%= n.slug %>.html" class="btn-ghost"><%= b.news_intro.read_more_label %></a>
          </div>
        </article>
<% }) %>
      </div>
    </div>
  </section>

<%- include('../partials/cta') %>
</main>

<%- include('../partials/footer') %>
