<% if (page.cta_enabled) { %>
  <section class="section-forest">
    <div class="container" style="text-align:center;">
      <p class="eyebrow on-dark" style="justify-content:center;"><%= page.cta_eyebrow %></p>
      <h2 style="max-width:600px; margin:0 auto 18px;"><%= page.cta_title %></h2>
      <a href="<%= page.cta_url %>" class="btn btn-primary"><%= page.cta_label %></a>
    </div>
  </section>
<% } %>
